NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/weeee-cafe

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# From @BotFather. Leave empty to run without the bot (no notifications).
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the deployed (or tunnelled) customer Mini App
MINI_APP_URL=
# Set to false to disable long polling (e.g. when another process runs the bot)
BOT_POLLING=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Shop timezone offset from UTC in minutes (Cambodia = 420), used for "today" stats
SHOP_UTC_OFFSET_MINUTES=420

# DEV ONLY: lets the Mini App log in from a normal browser without Telegram.
# Ignored when NODE_ENV=production.
ALLOW_DEV_AUTH=true

# Used by `npm run seed` to create the owner account (a super admin is also seeded, see src/scripts/seed.js)
SEED_ADMIN_EMAIL=owner@weeee.cafe
SEED_ADMIN_PASSWORD=change-me-please
